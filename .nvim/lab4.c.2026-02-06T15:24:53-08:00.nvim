#define _POSIX_C_SOURCE 200809L
#define _GNU_SOURCE
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define BLOCK_SIZE 128
#define HEAP_SIZE 256
#define BUF_SIZE 64

struct header {
  uint64_t size;
  struct header *next;
};

void errorMessage(const char *message) {
  perror(message);
  exit(EXIT_FAILURE);
};

void print_out(char *format, void *data, size_t dataSize) {
  char buffer[BUF_SIZE];
  ssize_t length;

  if (dataSize == sizeof(uint64_t)) {
    length = snprintf(buffer, BUF_SIZE, format, *(uint64_t *)data);
  } else {                                                 
    length = snprintf(buffer, BUF_SIZE, format, *(void **)data);
  }
  write(STDOUT_FILENO, buffer, length);
}

void print_block(char *start) {
  for (int i = 0; i < BLOCK_SIZE - sizeof(struct header); i++) {
    char *address = (start + sizeof(struct header) + i);
    uint64_t val = (uint64_t)*address;
    print_out("%lu\n", &val, sizeof(val));
  }
}

void initialize_block(struct header *block, uint64_t fullSize, struct header *next, int fill) {
  block -> size = fullSize;
  block -> next = next;
  memset(block + 1, fill, fullSize - sizeof(struct header));
}

int main(void) {
  char *heapS = sbrk(0);
  if (sbrk(HEAP_SIZE) == (void *)-1) {
    errorMessage("sbrk");
  }

  struct header *firstB = (struct header *)heapS;
  struct header *secondB = (struct header *)(heapS + BLOCK_SIZE);

  initialize_block(firstB, BLOCK_SIZE, NULL, 0);
  initialize_block(secondB, BLOCK_SIZE, firstB, 1);

  print_out("First Block: %p\n", &firstB, sizeof(firstB));
  print_out("Second Block: %p\n", &secondB, sizeof(secondB));
  print_out("First Block Size: %lu\n", &firstB->size,
            sizeof(firstB->size));
  print_out("First Block Next Address: %p\n", &firstB->next,
            sizeof(firstB->next));
  print_out("Second Block Size: %lu\n", &secondB->size,
            sizeof(secondB->size));
  print_out("Second Block Next Address: %p\n", &secondB->next,
            sizeof(secondB->next));
  print_block((char *)firstB);
  print_block((char *)secondB);

  return 0;
}
