#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
int main() {
  char *path = NULL;
  size_t size = 0;

  while (1) {
    printf("Enter programs to run.\n");
    getline(&path, &size, stdin);

    if (fork() == 0) {
      execl(path, path, NULL);
    } else {
      waitpid(-1, NULL, 0);
    }
  } 
  return 0;
}
